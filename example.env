# SSH Configuration
SSH_KEY=~/.ssh/your-ssh-key

# Docker Configuration
GHCR_USERNAME=username
GHCR_REPO=your-repo-name
GHCR_TOKEN=your_docker_token_here

DOMAIN=your-domain.com

# --- Fork identity (see docs/branding.md) ---------------------------------
# Public display name, used for og:title. Falls back to DOMAIN when unset.
SITE_NAME=
# Where THIS deployment's source lives. AGPL v3 section 13 requires offering
# users the source of the modified version they are running, and the footer
# link is how. Unset means the footer still points at upstream, which is only
# honest for an unmodified build -- the server warns about it at boot outside
# dev. canonical/og:url derive from DOMAIN above.
SOURCE_REPO_URL=

# API Key
API_KEY=your_api_key_here

# Optional CDN origin (e.g. https://cdn.example.com) prepended to hashed asset
# URLs from asset-manifest.json. Leave empty to serve assets from the same
# origin as the app. No trailing slash.
CDN_BASE=

# Server Hosts
SERVER_HOST_STAGING=123.456.78.90
SERVER_HOST_NBG1=123.456.78.92

# Version
VERSION_TAG="latest"

# --- Solana wager arena ---------------------------------------------------
# Leave ARENA_PROGRAM_ID empty to run the game with wagering disabled: the host
# UI hides the stake control and every lobby stays free to play.
#
# The server keypair is the match `authority`: it pays rent for each match's
# MatchAccount and vault ATA, and signs the result digest that settle_match
# verifies on-chain. It must be the SAME key in both roles, and it needs a
# funded SOL balance (use a devnet faucet for testing). It never custodies
# player stakes — those sit in a PDA-owned vault only the program can move.
SOLANA_RPC_URL=https://api.devnet.solana.com
# RPC endpoint handed to joining browsers, which submit their own join_match
# transaction. Falls back to SOLANA_RPC_URL when empty, so if that one embeds an
# API key (most paid providers put it in the path or query string) set this to a
# keyless public endpoint — its value is served to every joining player.
ARENA_PUBLIC_RPC_URL=
# Where the keypair lives *for the process reading it*. Set this directly when
# running locally (npm run dev). For a Docker deploy leave it empty and set
# ARENA_AUTHORITY_KEYPAIR instead -- update.sh bind-mounts that file read-only
# and appends the in-container path here itself, because a host path would be
# meaningless inside the container.
SERVER_KEYPAIR_PATH=
# Deploy only: path to the keypair *on the target host*. Mounted read-only
# rather than passed as an env var -- an env var would sit in `docker inspect`,
# in the deploy env file, in `ps`, and in any crash dump that prints the
# environment. Setting this also forces --restart=always, since a wagering
# server that stays down after a crash leaves live escrows with nothing to
# settle or refund them.
#
# The game container runs node as the unprivileged `node` user (uid 1000, see
# supervisord.conf), so the host file must be readable by that uid -- a 600
# root-owned key mounts fine and is then unreadable inside. `chown 1000:1000`
# it, or make it group-readable by that gid.
ARENA_AUTHORITY_KEYPAIR=
ARENA_PROGRAM_ID=
# The SPL token every stake is denominated in. REQUIRED once ARENA_PROGRAM_ID
# is set -- the server refuses to offer wagering without it, because a stake
# tier of "5" is meaningless without a token and its decimals.
#
# Verified at boot: the account must exist, be owned by the LEGACY SPL Token
# program (a Token-2022 mint can never be escrowed -- the program pins
# Program<Token>), be initialized, and declare at most 9 decimals. A mint with
# a freeze authority is allowed but warned about loudly: if it freezes the
# vault or a player's token account, BOTH settle_match and cancel_match fail
# and those stakes have no on-chain path out.
ARENA_STAKE_MINT=
# Display-only ticker, e.g. USDC. Shown beside every stake amount. Max 12 of
# [A-Za-z0-9._-]. It is an operator claim, not on-chain metadata, which is why
# the mint address stays visible in the stake prompt next to it. Empty falls
# back to showing the address.
ARENA_STAKE_SYMBOL=
# House cut in basis points, 0..1000 (10% is the program's hard ceiling).
ARENA_RAKE_BPS=0
# Ceiling on a single seat's stake, in token base units. Empty = no ceiling.
# Operator-set, never host-set.
#
# Hosts choose from the fixed tiers 1 / 5 / 25 (whole tokens), so this acts as
# a FILTER on which of those are offered: at 6 decimals, 5000000 offers 1 and 5
# and suppresses 25. Note the meaning depends on ARENA_STAKE_MINT's decimals --
# the same number is tier 5 on a 6-decimal mint and 0.005 on a 9-decimal one --
# so the server logs which tiers it took this to mean at boot. A value that
# suppresses every tier is refused at boot rather than silently disabling
# wagering.
#
# Worth setting regardless: tier 25 across 16 players is a 400-token pot, and
# maxPlayers is still host-chosen.
ARENA_MAX_ENTRY_FEE=
# Whether a wagered lobby may be advertised in the public lobby browser.
# Default off -- wagered lobbies are private, invite-only, and found by sharing
# the lobby id.
#
# THIS IS NOT A PLAIN BOOLEAN. Setting it true is a request, not a decision.
# The server honours it only after a replay verification has actually succeeded
# on that process at boot: it plays a short match, then re-derives it through
# the production verifier (src/server/arena/replayProbe.ts). If that fails --
# map data missing from the image, the worker thread unable to load its own
# modules -- the flag is refused with a named reason and wagered lobbies stay
# private.
#
# The reason for the ceremony: a public queue is the easiest place to assemble
# a colluding majority, and the only thing that makes one defensible is that
# the server decides the winner itself by replaying the match rather than
# taking the clients' vote (Phase 4). On a deployment that cannot verify, every
# wagered match refuses to settle and refunds on the 24h timeout -- so a public
# queue there would recruit strangers into lobbies that can only ever refund.
# Same posture as ARENA_DEV_BYPASS below, which will not trust its own env var
# until it has asked the cluster for its genesis hash.
ARENA_PUBLIC_WAGER_LOBBIES=false
# DEV ONLY, DEFAULT OFF. Skips the wallet-signature session binding and the
# on-chain stake check, so a player can take a wagered seat without paying.
# That fills the escrow to InProgress with a partial pot, which then settles
# and pays out for real. Only honoured when GAME_ENV=dev AND the cluster's
# genesis hash proves it is not mainnet -- the server refuses otherwise, and
# also refuses when it cannot reach the RPC to check. Never set in production.
ARENA_DEV_BYPASS=false
# Token account the rake is paid into. Must be an SPL token account for the
# same mint the match is staked in -- checked at boot now that the server knows
# the mint, and again on chain by settle_match, because a mismatch fails the
# rake transfer and takes the whole settlement down with it, stranding the pot.
# Required only when ARENA_RAKE_BPS > 0.
#
# Read once, at create_match, and recorded on the match account; settle_match
# then refuses to pay the rake anywhere else. So changing this affects only
# matches created afterwards -- escrows already live keep paying the treasury
# they were created with, which is deliberate: an operator must not be able to
# redirect the cut on a pot players have already staked into.
TREASURY_TOKEN_ACCOUNT=

# --- Auth service (src/auth, H4) ------------------------------------------
# Upstream's JWT issuer is a closed-source Cloudflare Worker that is not in
# this repo, so this fork ships its own. It runs as a SECOND container behind
# the same proxy at api.$DOMAIN, and the game server and the browser both
# compute that URL themselves -- neither reads a variable for it.
#
# The signing key is an Ed25519 private JWK. Generate it ONCE with
#   npx tsx scripts/generateAuthKey.ts /opt/openfront/auth-signing-key.json
# and never rotate it casually: rotating logs every player out, and the game
# server caches the first JWKS response for the life of its process, so it will
# keep rejecting tokens until it too restarts. The service refuses to boot
# outside dev when this is unset rather than minting a throwaway key.
#
# Set this directly when running locally. For a Docker deploy leave it empty
# and set AUTH_SIGNING_KEY instead -- update.sh bind-mounts that file read-only
# and appends the in-container path here itself, the same way it does for the
# arena authority keypair.
AUTH_SIGNING_KEY_PATH=
# Deploy only: path to the signing key *on the target host*. Mounted read-only
# rather than passed as an env var, for the same reason as the arena keypair:
# an env var lands in `docker inspect`, in the deploy env file, in `ps`, and in
# any crash dump that prints the environment. Setting this is what makes the
# deploy start an auth container at all.
AUTH_SIGNING_KEY=
# Port the service listens on. The issuer is pinned to http://localhost:8787
# for DOMAIN=localhost regardless -- proxy to this port if you change it.
AUTH_PORT=8787
# `Domain` attribute on the refresh cookie. Empty means host-only (scoped to
# api.$DOMAIN), which is the only origin that reads it and therefore correct.
AUTH_COOKIE_DOMAIN=
# `Secure` on the refresh cookie. Defaults to on outside dev; only set this to
# false for a deliberately plain-http deployment, and note a Secure cookie is
# silently dropped by the browser over http.
AUTH_COOKIE_SECURE=
# Whether /users/@me reports canCreatePublicLobbies. Upstream gates this on a
# subscription; this fork has no subscription backend, so it is the operator's
# call. Wagered lobbies stay private-only either way -- POST /wager rejects a
# listed lobby and /listing rejects a wagered one.
AUTH_ALLOW_PUBLIC_LOBBIES=true
# Extra browser origins allowed to send credentialed auth requests, comma
# separated. https://$DOMAIN, https://*.$DOMAIN and dev localhost are allowed
# without listing them; this is for anything else (e.g. app://openfront).
AUTH_ALLOWED_ORIGINS=

# Private match telemetry (disabled by default)
TELEMETRY_ENABLED=false
TELEMETRY_INGEST_URL=
TELEMETRY_SIGNING_SECRET=
TELEMETRY_BATCH_SIZE=200
TELEMETRY_FLUSH_INTERVAL_MS=1000
TELEMETRY_REQUEST_TIMEOUT_MS=5000
TELEMETRY_MAX_QUEUE_SIZE=20000
TELEMETRY_MAX_QUEUE_BYTES=33554432
TELEMETRY_MAX_EVENT_BYTES=1048576
TELEMETRY_PER_PLAYER_PER_TICK_CAP=32
