# [ARENA] Caddy config for the fork. Install to /etc/caddy/Caddyfile.
#
# TWO different certificates, and which host gets which is not a preference:
#
#   apex + www  -> the Cloudflare ORIGIN certificate. They are Cloudflare-
#                  PROXIED, so the browser is served Cloudflare's own Universal
#                  SSL and this certificate is seen only by Cloudflare. Valid 15
#                  years, no renewal, and no ACME challenge to fight "Always Use
#                  HTTPS" over.
#
#   api.        -> a real LET'S ENCRYPT certificate, obtained and renewed by
#                  Caddy. It is DNS-only, so browsers and the game container
#                  reach it DIRECTLY -- and an origin certificate is trusted by
#                  Cloudflare and by nothing else, so serving it here fails with
#                  SEC_E_UNTRUSTED_ROOT and auth stops working entirely.
#
# Getting this backwards is not subtle in effect but is very easy to do, because
# the origin certificate's SANs cover *.warchest-arena.com and therefore LOOK
# sufficient for api. Coverage is not the issue; trust is.
#
# Cloudflare's SSL/TLS mode must be **Full (strict)**. Flexible sends plaintext
# to this box, which breaks the auth refresh cookie's Secure attribute; plain
# Full does not validate this certificate, which throws away the point of it.
#
# Install:
#   sudo cp deploy/Caddyfile /etc/caddy/Caddyfile
#   sudo caddy validate --config /etc/caddy/Caddyfile
#   sudo systemctl reload caddy

{
	# `disable_redirects`, NOT `off`: Caddy must still manage a certificate for
	# api.warchest-arena.com (see the bottom of this file), and `off` would
	# disable that too. What it must not do is add its own http->https redirects
	# for the Cloudflare-proxied hosts, because Cloudflare's "Always Use HTTPS"
	# already redirects there and both together is ERR_TOO_MANY_REDIRECTS.
	auto_https disable_redirects

	# Where Let's Encrypt sends expiry warnings for the api. certificate.
	email admin@warchest-arena.com
}

(origin_tls) {
	tls /etc/caddy/certs/origin.pem /etc/caddy/certs/origin.key
}

# Plain http. api. is the only host reachable this way from outside (it is
# DNS-only, so Cloudflare never sees it); the apex and www are here for the case
# where someone reaches this box by IP or with Cloudflare bypassed.
#
# api. is deliberately NOT redirected: Caddy needs port 80 on that host to
# answer Let's Encrypt's HTTP-01 challenge. Caddy serves the challenge path
# ahead of site routes, so a redirect here would not actually break issuance --
# but leaving it out removes the question entirely.
http://warchest-arena.com, http://www.warchest-arena.com {
	redir https://{host}{uri} permanent
}

# One canonical origin. canonical/og:url derive from DOMAIN (the apex), and a
# second live origin means a second cookie scope and a second CORS origin for
# no benefit.
https://www.warchest-arena.com {
	import origin_tls
	redir https://warchest-arena.com{uri} permanent
}

https://warchest-arena.com {
	import origin_tls

	# nginx inside the container listens on 80; the Dockerfile has no EXPOSE,
	# so warchest.sh publishes it to loopback.
	#
	# reverse_proxy passes WebSocket upgrades through without configuration,
	# which matters: every live game's connection rides /wN, and nginx already
	# sets Upgrade/Connection on that location.
	#
	# Do NOT add `encode` here -- the worker already runs compression()
	# middleware, and compressing twice costs CPU for nothing.
	reverse_proxy 127.0.0.1:8080
}

# api. is intentionally DNS-only in Cloudflare. The game container fetches
# /.well-known/jwks.json, /users/@me, /cosmetics.json and /reserved_clan_tags
# from this hostname SERVER-SIDE, from this same box; proxying it would send
# local traffic out to Cloudflare and back, and add a third-party dependency to
# a call that never needs to leave the machine.
#
# The hostname is not configurable. AuthEnv.issuer(), ServerEnv.jwtIssuer() and
# ClientEnv.jwtIssuer() each independently COMPUTE https://api.$DOMAIN, and
# jwtVerify rejects any other issuer. AUTH_PORT changes only the listen port.
# NOTE the absence of `import origin_tls` here, which is the whole point.
#
# A Cloudflare ORIGIN certificate is trusted by Cloudflare and by nothing else.
# The apex gets away with it because Cloudflare proxies it and presents its own
# Universal SSL to the browser -- the origin cert is only ever seen by
# Cloudflare. api. is DNS-only, so browsers AND the game container connect here
# directly and see whatever this block serves. Serving the origin cert there
# fails with SEC_E_UNTRUSTED_ROOT / UNABLE_TO_VERIFY_LEAF_SIGNATURE, and auth
# stops working entirely: no login in the browser, and no JWKS fetch server-side.
#
# So this host gets a real Let's Encrypt certificate, which Caddy obtains and
# renews by itself over HTTP-01 on port 80. That works precisely BECAUSE api. is
# grey-clouded: nothing intercepts the challenge. Proxying this host would break
# it again and would also send the container's own JWKS fetch out to Cloudflare
# and back for traffic that never needs to leave the machine.
https://api.warchest-arena.com {
	# Explicit, so the intent survives someone re-adding a wildcard later.
	#
	# ⚠️ THE ORIGIN CERTIFICATE MUST NOT COVER *.warchest-arena.com.
	# Caddy matches certificates out of one process-wide cache by SAN, and a
	# loaded wildcard matches api. -- at which point Caddy logs "skipping
	# automatic certificate management because one or more matching certificates
	# are already loaded" and serves the untrusted origin cert here regardless of
	# this block. There is no per-site scoping and no force_automate in Caddy
	# 2.11. Issue the Cloudflare origin certificate for the apex and www ONLY.
	tls {
		issuer acme
	}
	reverse_proxy 127.0.0.1:8787
}

# ---------------------------------------------------------------------------
# On X-Forwarded-For, because it decides whether the rate limiter works.
#
# The chain the game server sees is:
#
#   client -> Cloudflare -> Caddy -> nginx -> Express
#
# Cloudflare sets X-Forwarded-For to the client IP; Caddy appends Cloudflare's
# edge IP; nginx appends Caddy's. Express with `trust proxy = 3`
# (Master.ts, Worker.ts) walks back past all three and lands on the real client.
# That is why those values are correct AS SHIPPED and need no patch.
#
# The auth service is different and also correct as shipped: api. is DNS-only,
# so its chain is just Caddy -> Express, and routes.ts sets `trust proxy = 1`.
#
# If you ever grey-cloud the apex, `trust proxy` must drop to 2 in Master.ts and
# Worker.ts -- otherwise req.ip takes a client-supplied XFF entry, the per-IP
# rate limiter becomes trivially bypassable, and the anonymised IPs in the logs
# stop meaning anything.
# ---------------------------------------------------------------------------
