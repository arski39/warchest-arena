# [ARENA] The deployment env file. Copy to /opt/warchest/warchest.env, fill in,
# chmod 600. deploy/warchest.sh reads it, derives a runtime copy (adding the
# in-container SERVER_KEYPAIR_PATH), and hands that to `docker run --env-file`.
#
# --env-file, not dotenv, and that is load-bearing: ServerEnv reads GAME_ENV in
# a STATIC FIELD INITIALIZER at module import, and Server.ts calls
# dotenv.config() *after* its imports. ESM evaluates the whole module graph
# first, so a GAME_ENV that only lives in a file the app parses itself arrives
# too late and the process dies with a bare `unsupported game env: undefined`.

# ---------------------------------------------------------------- required
# Each of these produces a 500 on EVERY GET / while /api/health still returns
# 200 -- RenderHtml.ts reads all four while building its EJS data object.
GAME_ENV=prod
NUM_WORKERS=3
TURNSTILE_SITE_KEY=0x4AAAAAAEroxOraIFWL6s5V
DOMAIN=warchest-arena.com

# NUM_WORKERS is a PICK-ONCE decision. Game ids shard by
# simpleHash(gameID) % NUM_WORKERS, so changing it later routes every live
# match's URL to a worker that has never heard of it. It also reaches
# generate-nginx-upstream.sh, which silently defaults to 1 if unset.

# TURNSTILE_SITE_KEY is the PUBLIC half -- it is rendered into every page, so it
# is not a secret. The secret half is TURNSTILE_SECRET_KEY, near the bottom,
# read only by the auth container. Both are needed: with the site key alone the
# widget renders and nothing checks the token it produces.
# Cloudflare's always-passes test key is 1x00000000000000000000AA.

# ------------------------------------------------------------------- site
SUBDOMAIN=main
SITE_NAME=Warchest Arena
# AGPL v3 section 13: users of a network service must be offered the source of
# the version they are running. This is that link. Unset means the footer
# points at upstream, which is only honest for an unmodified build.
SOURCE_REPO_URL=https://github.com/arski39/warchest-arena
# Empty = assets served same-origin from static/ through nginx. Do not point
# this at upstream's R2 flow; api.$DOMAIN/game_assets/* does not exist in this
# fork. With GAME_ENV=prod and this empty, /desktop/version.json and
# /desktop/release.json return 500 -- they serve the Steam client's update
# descriptor, which this deployment does not ship. Accepted.
CDN_BASE=
API_KEY=

# ------------------------------------------------------------------ arena
# Leave ARENA_PROGRAM_ID empty to run free-to-play: the host UI hides the stake
# control and every lobby stays free. That is a supported mode, not a failure.
SOLANA_RPC_URL=https://api.devnet.solana.com
# Served to EVERY joining browser, which submits its own join_match. Keep it
# keyless even if SOLANA_RPC_URL above is not.
ARENA_PUBLIC_RPC_URL=https://api.devnet.solana.com
ARENA_PROGRAM_ID=4CGRLB5WJ4LK4nqwhzN5uhU78cakuHzG5wfrUZrQ2G64
# Must exist, be owned by the LEGACY SPL Token program (a Token-2022 mint can
# never be escrowed by this program), be initialized, and declare <= 9 decimals.
ARENA_STAKE_MINT=
ARENA_STAKE_SYMBOL=WARC
# 0..1000. Operator-set, never host-set. Above 0 requires TREASURY_TOKEN_ACCOUNT
# of the SAME mint, checked at boot -- a mismatch would take the whole
# settlement down and strand the pot.
ARENA_RAKE_BPS=250
TREASURY_TOKEN_ACCOUNT=
# Ceiling on one seat's stake, in token BASE UNITS, and it also filters which of
# the 1/5/25 tiers are offered. Empty = no ceiling. A value that suppresses
# every tier is refused at boot.
ARENA_MAX_ENTRY_FEE=
# Never true on a public site. The deploy script refuses it outright.
ARENA_DEV_BYPASS=false
# A request, not a decision: the server honours it only after a replay
# verification actually succeeds on that worker at boot. Turn on at [F].
ARENA_PUBLIC_WAGER_LOBBIES=false

# Host path to the match authority keypair. Generated ON THE BOX with
# solana-keygen; must never exist anywhere else. warchest.sh bind-mounts it
# read-only at /run/secrets/arena-authority.json and sets SERVER_KEYPAIR_PATH
# itself -- do not set that here, and never put a key in an env var, because
# that lands in `docker inspect`, in `ps`, and in any crash dump.
#
# Must be readable by uid 1000 (the container runs node as `node`). On Ubuntu
# cloud images uid 1000 is `ubuntu`, so owning it as ubuntu is correct.
# Needs >= 0.05 SOL; each live match locks ~0.0085 SOL of rent, returned by
# close_match. That floor is read ONCE at boot and never again as it drains.
ARENA_AUTHORITY_KEYPAIR=/opt/warchest/arena-authority.json

# ------------------------------------------------------------------- auth
# Host path to the Ed25519 signing JWK. Generate ONCE:
#   docker run --rm -v /opt/warchest:/out warchest:latest \
#     npx tsx scripts/generateAuthKey.ts /out/auth-signing-key.json
# A key minted per start logs every player out on each deploy, AND the game
# server caches the first JWKS response for the life of its process.
# Setting this is also what makes the deploy start an auth container at all.
AUTH_SIGNING_KEY=/opt/warchest/auth-signing-key.json
# Listen port only. It does NOT change the issuer, which all three of the auth
# service, the game server and the browser each compute as https://api.$DOMAIN.
AUTH_PORT=8787
AUTH_COOKIE_SECURE=true
AUTH_ALLOW_PUBLIC_LOBBIES=true
# The SECRET half of the Turnstile widget whose site key is above. Read ONLY by
# the auth container -- it must never reach a browser.
#
# Empty leaves /join_verify unregistered, so it 404s and JoinVerify.ts falls
# open: the widget renders and verifies nothing. That is this fork's historical
# behaviour and the honest default, but it is not bot protection.
#
# Get it from the Cloudflare dashboard -> Turnstile -> your widget -> Settings.
TURNSTILE_SECRET_KEY=

# GIT_COMMIT is baked into the image by --build-arg at build time.
# INSTANCE_ID and WORKER_ID are set by the cluster master. Never set them here.
